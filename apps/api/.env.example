# ---------------------------------------------------------------------------
# CyberPingo API - example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# PostgreSQL connection string (matches docker-compose.yml defaults).
DATABASE_URL=postgresql://cyberpingo:cyberpingo@localhost:5432/cyberpingo?schema=public

# Generate strong random values, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Rate limiting (window in milliseconds, max requests per window per IP).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
