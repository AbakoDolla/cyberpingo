# Copie ce fichier en .env.local puis renseigne les valeurs.
# Les variables NEXT_PUBLIC_* sont incluses dans le code envoyé au navigateur :
# n'y place jamais de clé secrète (service_role, mot de passe de base…).

# Supabase — Project Settings > API (ou Data API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé « anon » (ou « publishable »). Protégée par les règles RLS des migrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# Fournisseurs OAuth activés dans Supabase > Authentication > Providers.
# Laisser vide pour masquer les boutons. Valeurs possibles : github,google
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=

# Gemini (Google AI Studio) — serveur uniquement, jamais exposée au client.
# Utilisée par le mentor IA et l'analyse de PDF de l'espace publication.
# Clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modèle optionnel (par défaut gemini-2.5-flash)
GEMINI_MODEL=
