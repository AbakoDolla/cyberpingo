# Copie ce fichier en .env.local puis renseigne les valeurs.
# Les variables NEXT_PUBLIC_* sont incluses dans le code envoyé au navigateur :
# n'y place jamais de clé secrète (service_role, mot de passe de base…).

# Supabase — Project Settings > API (ou Data API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé « anon ». Protégée par les règles RLS des migrations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
# Alternative : nouvelle clé « publishable » (sb_publishable_…), utilisée si la clé anon est vide.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fournisseurs OAuth activés dans Supabase > Authentication > Providers.
# Laisser vide pour masquer les boutons. Valeurs possibles : github,google
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=

# Gemini (Google AI Studio) — serveur uniquement, jamais exposée au client.
# Utilisée par le mentor IA et l'analyse de PDF de l'espace publication.
# Clé : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modèle optionnel (par défaut gemini-2.5-flash)
GEMINI_MODEL=

# --- Edge Functions (NE PAS mettre ici ni dans Vercel) ---
# Se règlent avec : npx supabase secrets set SITE_URL=https://… ALLOWED_ORIGINS=https://…
#   SITE_URL         URL publique du site (liens de réinitialisation, vérification des certificats)
#   ALLOWED_ORIGINS  Origines CORS autorisées, séparées par des virgules
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectées automatiquement
# par Supabase dans les fonctions. La clé service_role ne doit jamais apparaître côté frontend.
