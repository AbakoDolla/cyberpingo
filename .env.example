# URL de base de l'API NestJS (services/api.ts). Utilise des données
# mockées tant que cette variable n'est pas définie / que le backend
# n'existe pas encore.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Clé Gemini (Google AI Studio) — serveur uniquement, jamais exposée au client
# Obtenir une clé sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
