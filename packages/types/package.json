{
  "name": "@cyberpingo/types",
  "version": "0.1.0",
  "private": true,
  "description": "Domain types shared between the CyberPingo web app and REST API",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"@cyberpingo/types is type-only and has no runtime tests\"",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@cyberpingo/config": "workspace:*",
    "typescript": "^5.6.2"
  }
}
